FROM golang:latest AS builder

WORKDIR /srv

RUN apt-get update && apt-get install -y --no-install-recommends \
  git \
  && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN go build -o app .

FROM scratch

WORKDIR /srv

COPY --from=builder /srv/app .

EXPOSE 8080

ENTRYPOINT [ "./app" ]
